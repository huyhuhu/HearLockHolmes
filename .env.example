# Firebase web app config (Firebase Console → Project settings → Your apps)
# Copy this file to .env.local and fill in. App runs without it (local mode, no login).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tuỳ chọn — QA E2E với Firebase Emulator (không cần tài khoản Google thật):
# đặt VITE_FIREBASE_EMULATOR=1 để trỏ Auth vào 127.0.0.1:9099 và
# Firestore vào 127.0.0.1:8080 (chạy `npx firebase-tools emulators:start`).
# KHÔNG đặt biến này khi dùng Firebase thật.
# VITE_FIREBASE_EMULATOR=1
